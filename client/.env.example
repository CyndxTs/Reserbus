# Copia este archivo como ".env.local" y completa los valores.
# Vite solo expone variables que empiezan con VITE_ (todo lo que pongas aquí es PÚBLICO).

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# En desarrollo déjalo vacío: Vite hace proxy de /api -> http://localhost:3001
# En producción (Vercel) pon la URL de la API desplegada, sin "/" al final:
# VITE_API_URL=https://reserbus-api.vercel.app
VITE_API_URL=
