# Copia este archivo como ".env" y completa los valores. NUNCA lo subas a Git.

PORT=3001

# Orígenes permitidos por CORS (separados por coma, sin "/" al final)
CLIENT_ORIGINS=http://localhost:3000

# Supabase
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_JWKS_URL=https://TU-PROYECTO.supabase.co/auth/v1/.well-known/jwks.json
# Secret key (service role): SOLO server, jamás en el front
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Base de datos (Supabase -> Connect). Para Vercel usa el pooler (puerto 6543 o 5432 del pooler)
DB_HOST=aws-0-xx.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.TU_REF_PROYECTO
DB_PASSWORD=tu-password
